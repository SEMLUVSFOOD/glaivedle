# ── Required ────────────────────────────────────────────────────────────────
# Long random string used to sign admin sessions and seal game tokens.
# Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# Password for /admin
ADMIN_PASSWORD=change-me

# ── Optional ────────────────────────────────────────────────────────────────
# Public URL of the site (used for share text + metadata)
PUBLIC_URL=https://glaivedle.lol

# Which artist the site is about (slug) and how to find them on Deezer.
ARTIST_SLUG=glaive
ARTIST_NAME=glaive
# Optional: pin the Deezer artist id instead of searching by name
DEEZER_ARTIST_ID=7411938

# Genius API token (https://genius.com/api-clients). Enables producer credits,
# unreleased songs for hard mode, and Genius as a lyrics fallback.
GENIUS_ACCESS_TOKEN=

# Timezone the daily puzzle resets in, and the day of puzzle #1
DAILY_TIMEZONE=Europe/Amsterdam
LAUNCH_DATE=2026-11-17

# Where the SQLite database lives (mount a volume here in Docker/Coolify)
DATABASE_PATH=./data/glaivedle.db

# Hours between automatic catalog re-syncs (0 = disabled)
SYNC_INTERVAL_HOURS=24
